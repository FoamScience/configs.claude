{
  "_comment": "OPT-IN fragment. These hooks require private tools on PATH: cavemem (npm global bin) and fable (bin). Merged only with `install.sh --personal`. claudetell is NOT here — it registers its own hooks via its CLI (uv run claudetell.py install).",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "skipAutoPermissionPrompt": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cavemem hook run session-start --ide claude-code"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "fable hook",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cavemem hook run user-prompt-submit --ide claude-code"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "fable hook"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cavemem hook run post-tool-use --ide claude-code"
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|Read|TaskCreate|TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "fable hook"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cavemem hook run stop --ide claude-code"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "fable hook"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cavemem hook run session-end --ide claude-code"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "fable hook",
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "fable hook"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "fable hook",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "cavemem": {
      "command": "cavemem",
      "args": [
        "mcp"
      ]
    }
  }
}
